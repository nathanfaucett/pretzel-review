{
	"name": "pretzels",
	"description": "Soft Pretzels Review website",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"tauri": "tauri",
		"vite": "vite",
		"svelte-kit": "svelte-kit",
		"typesafe-i18n": "typesafe-i18n",
		"clean": "rm -rf node_modules/.vite .svelte-kit build",
		"start": "npm-run-all --parallel web typesafe-i18n",
		"web": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/deep-equal": "^1.0.4",
		"@types/node": "^22.19.15",
		"@types/postcss-import": "^14.0.3",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"autoprefixer": "^10.4.27",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.8",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte-check": "^3.8.6",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"vite": "^5.4.21"
	},
	"dependencies": {
		"@aicacia/debounce": "^0.1.25",
		"@aicacia/rand": "^0.2.14",
		"@aicacia/string-fuzzy_equals": "^0.1.4",
		"@octokit/rest": "^21.1.1",
		"@svelte-put/clickoutside": "^3.0.2",
		"buffer": "^6.0.3",
		"locale-codes": "^1.3.1",
		"lucide-svelte": "^0.577.0",
		"svelte": "^4.2.20",
		"svelte-localstorage-writable": "^0.1.3",
		"svelte-portal": "^2.2.1",
		"svelte-seo": "^1.7.1",
		"vest": "^5.4.6"
	}
}
